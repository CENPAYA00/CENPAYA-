name: worker-verify

on:
  push:
    branches:
      - migration/neon-worker-api
    paths:
      - 'worker/**'
      - '.github/workflows/worker-verify.yml'
  workflow_dispatch:

jobs:
  worker-checks:
    runs-on: ubuntu-latest
    permissions:
      contents: read

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install Worker dependencies
        working-directory: worker
        run: npm install

      - name: Type-check Worker
        working-directory: worker
        run: npm run typecheck

      - name: Substitute Hyperdrive ID and run Wrangler dry-run
        working-directory: worker
        env:
          CLOUDFLARE_API_TOKEN: ${{ secrets.CLOUDFLARE_API_TOKEN }}
          HYPERDRIVE_ID: ${{ secrets.HYPERDRIVE_ID }}
        shell: bash
        run: |
          set +x
          if [ -z "${HYPERDRIVE_ID:-}" ]; then
            echo "::error::Required repository secret HYPERDRIVE_ID is missing or empty."
            exit 1
          fi
          echo "::add-mask::$HYPERDRIVE_ID"

          python - <<'PY'
          import os
          from pathlib import Path

          config = Path("wrangler.toml")
          text = config.read_text()
          placeholder = "REPLACE_WITH_EXISTING_HYPERDRIVE_ID"
          if text.count(placeholder) != 1:
              raise SystemExit("Expected Hyperdrive ID placeholder exactly once in wrangler.toml.")
          config.write_text(text.replace(placeholder, os.environ["HYPERDRIVE_ID"]))
          PY

          npx wrangler deploy --dry-run
