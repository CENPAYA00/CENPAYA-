# Required shared secret; must match D1 Worker's VIDEO_PROCESSOR_TOKEN
VIDEO_PROCESSOR_TOKEN=

# Backblaze B2 primary storage
B2_REGION=eu-central-003
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=

# Tigris backup storage
TIGRIS_REGION=auto
TIGRIS_ENDPOINT=https://t3.storage.dev
TIGRIS_ACCESS_KEY_ID=
TIGRIS_SECRET_ACCESS_KEY=
TIGRIS_BUCKET_NAME=

PORT=8080
